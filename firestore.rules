    function isFodSoApproverProfile(profile, designation) {
      return profile.get("accountStatus", "Approved") in ["Approved", null]
        && isFodCalendarApproverProfile(profile, designation);
    }
    function isActiveFodSoApproverForUnit(userId, designation, unit) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return userId is string
        && userId.size() > 0
        && exists(userPath)
        && isFodSoApproverProfile(get(userPath).data, designation);
    }
    function validFodSpecialOrderWorkflow(data, ownerProfile) {
      return data.get("approvalWorkflow", "") == "fod"
        && data.get("approvalStage", "") == "owner-send"
        && data.get("ownerOffice", "") == "Division"
        && data.get("ownerDivision", "") == "Field Operations Division"
        && data.get("ownerUnit", "") is string
        && data.get("ownerUnit", "").lower() in ["agristat", "amia", "drrm"]
        && isFodCalendarRegularOwner(ownerProfile)
        && data.get("ownerUnit", "") == ownerProfile.get("unit", "")
        && data.get("initialSignerId", "") is string
        && data.get("initialSignerId", "").size() > 0
        && data.get("initialSignerId", "").size() <= 128
        && isActiveFodSoApproverForUnit(data.initialSignerId, "AGRISTAT/DRRM/AMIA Project Leader", "Field Operations Division")
        // Validate the saved route against current Admin profiles. Signature
        // actions also recheck the signer against their live profile.
        && data.get("chiefSignerId", "") is string
        && data.get("chiefSignerId", "").size() > 0
        && data.get("chiefSignerId", "").size() <= 128
        && isActiveFodSoApproverForUnit(data.chiefSignerId, "Chief", "Field Operations Division")
        && data.initialSignerId != data.chiefSignerId
        && data.initialSignerId != request.auth.uid
        && data.chiefSignerId != request.auth.uid
        && data.get("signatoryName", "") is string
        && data.get("signatoryName", "").size() > 0
        && data.get("signatoryName", "").size() <= 120
        // The selected SO signatory is a display choice. The approval route
        // is determined by initialSignerId and chiefSignerId, so allow every
        // configured dropdown choice without coupling it to those approvers.
        && data.get("signatoryDesignation", "") is string
        && data.get("signatoryDesignation", "").size() > 0
        && data.get("signatoryDesignation", "").size() <= 120
        && data.get("affixInitialSignature", "") == "No"
        && data.get("affixChiefInitialSignature", "") == "No";
    }
    function canCreateFodSpecialOrder(data) {
      let ownerPath = currentUserPath();
      let ownerProfile = get(ownerPath).data;
      return isEmailVerified()
        && exists(ownerPath)
        && data.get("ownerId", "") == request.auth.uid
        && ownerProfile.get("accountStatus", "Approved") in ["Approved", null]
        && validFodSpecialOrderWorkflow(data, ownerProfile);
    }
    function isFodSoInitialSigner(order) {
      return isVerifiedUser()
        && order.get("approvalWorkflow", "") == "fod"
        && order.get("initialSignerId", "") == request.auth.uid
        && isActiveFodSoApproverForUnit(request.auth.uid, "AGRISTAT/DRRM/AMIA Project Leader", "Field Operations Division");
    }
    function isFodSoChiefSigner(order) {
      return isVerifiedUser()
        && order.get("approvalWorkflow", "") == "fod"
        && order.get("chiefSignerId", "") == request.auth.uid
        && isActiveFodSoApproverForUnit(request.auth.uid, "Chief", "Field Operations Division")
        && order.get("affixInitialSignature", "") == "Yes";
    }
    function canAffixFodSoInitialSignature() {
      return isFodSoInitialSigner(resource.data)
        && isFodSignatureTransition("initial", "initialSignerId", "", "affixInitialSignature", "initialSignatureURL", "chief", true);
    }
    function canAffixFodChiefSignature(signatureKey, profileUrlKey, nextStage) {
      return isFodSoChiefSigner(resource.data)
        && isFodSignatureTransition("chief", "chiefSignerId", "", signatureKey, profileUrlKey, nextStage, true);
    }
    function isFodNtaWorkflowOwner() {
      return isFodCalendarRegularOwner(get(currentUserPath()).data);
    }
    function ntaSignatoryDesignation(profile) {
      let designation = profile.get("designation", "");
      return designation is string
        && (designation == "Chief" || designation.matches("(^|.*;)\\s*Chief\\s*(;.*|$)")) ? "Chief"
        : designation is string
          && (designation == "OIC" || designation.matches("(^|.*;)\\s*OIC\\s*(;.*|$)")) ? "OIC"
          : "";
    }
    function isActiveNtaAdminSignatory(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return userId is string
        && userId.size() > 0
        && userId.size() <= 128
        && exists(userPath)
        && normalizedAccountRole(get(userPath).data) == "admin"
        && get(userPath).data.get("accountStatus", "Approved") in ["Approved", null]
        && ntaSignatoryDesignation(get(userPath).data) in ["Chief", "OIC"]
        && get(userPath).data.get("name", "") is string
        && get(userPath).data.get("name", "").size() > 0
        && get(userPath).data.get("name", "").size() <= 120;
    }
    function validNtaSignatory(data) {
      let signatoryId = data.get("signatoryAdminId", "");
      let signatoryPath = /databases/$(database)/documents/users/$(signatoryId);
      let profile = exists(signatoryPath) ? get(signatoryPath).data : {};
      let designation = ntaSignatoryDesignation(profile);
      let selectedDesignation = data.get("signatoryDesignation", "");
      return isActiveNtaAdminSignatory(signatoryId)
        && data.get("signatoryName", "") == profile.get("name", "")
        && selectedDesignation is string && selectedDesignation.size() <= 200
        && (selectedDesignation == designation
          || (designation == "Chief" && selectedDesignation.matches("^Chief, .+$"))
          || (designation == "OIC" && selectedDesignation.matches("^OIC, .+$")));
    }
    function validFodNtaWorkflow(data) {
      let ownerProfile = get(currentUserPath()).data;
      return data.get("approvalWorkflow", "") == "fod"
        && data.get("approvalStage", "") == "owner-send"
        && data.get("ownerOffice", "") == "Division"
        && data.get("ownerDivision", "") == "Field Operations Division"
        && data.get("ownerUnit", "") is string
        && data.get("ownerUnit", "").lower() in ["agristat", "amia", "drrm"]
        && isFodDivisionOffice(ownerProfile)
        && sameTextIgnoreCase(data.get("ownerUnit", ""), profileAssignment(ownerProfile))
        && isRegularSpecialOrderOwner(ownerProfile)
        && data.get("initialSignerId", "") is string
        && data.get("initialSignerId", "").size() > 0
        && data.get("initialSignerId", "").size() <= 128
        && exists(/databases/$(database)/documents/users/$(data.initialSignerId))
        && data.get("chiefSignerId", "") is string
        && data.get("chiefSignerId", "").size() > 0
        && data.get("chiefSignerId", "").size() <= 128
        && exists(/databases/$(database)/documents/users/$(data.chiefSignerId))
        && data.initialSignerId != data.chiefSignerId
