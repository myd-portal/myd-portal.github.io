        && request.resource.data.keys().hasAll(["ownerId", "travelOrderId"])
        && request.resource.data.keys().hasOnly(["ownerId", "travelOrderId"])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.travelOrderId is string
        && (get(/databases/$(database)/documents/travelOrders/$(request.resource.data.travelOrderId)).data.ownerId == request.auth.uid
          || canUpdateTravelOrderAsRecipient(get(/databases/$(database)/documents/travelOrders/$(request.resource.data.travelOrderId)).data))
        && getAfter(/databases/$(database)/documents/travelOrders/$(request.resource.data.travelOrderId)).data.status == "Approved");
      allow delete: if isSuperAdmin() || (isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && resource.data.travelOrderId is string
        && get(/databases/$(database)/documents/travelOrders/$(resource.data.travelOrderId)).data.ownerId == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/travelOrders/$(resource.data.travelOrderId)));
    }
    match /ntaRecords/{ntaId} {
      allow read: if isSuperAdmin() || (isVerifiedUser() && (resource.data.ownerId == request.auth.uid
        || (resource.data.ownerUnit is string && resource.data.ownerUnit == signedInUnit())
        || request.auth.uid in resource.data.get("recipientIds", [])));
      allow create: if isVerifiedUser() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerUnit == signedInUnit();
      allow update: if isSuperAdmin() || (isVerifiedUser() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && ownerUnitCanBeUpdated());
      allow delete: if isSuperAdmin() || (isVerifiedUser() && resource.data.ownerId == request.auth.uid);
    }
    match /myNotes/{noteId} {
      allow read: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasAll(["ownerId", "date", "task", "status", "remarks", "order", "createdAt"])
        && request.resource.data.keys().hasOnly(["ownerId", "date", "task", "status", "remarks", "order", "createdAt"])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.task is string
        && request.resource.data.task.size() > 0
        && request.resource.data.task.size() <= 1200
        && request.resource.data.status == "Pending"
        && request.resource.data.remarks is string
        && request.resource.data.remarks.size() <= 1200
        && request.resource.data.order is int
        && request.resource.data.order >= 0
        && request.resource.data.createdAt is timestamp;
      allow update: if isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["task", "status", "remarks", "order"])
        && request.resource.data.keys().hasAll(["ownerId", "date", "task", "status", "remarks", "order", "createdAt"])
        && request.resource.data.keys().hasOnly(["ownerId", "date", "task", "status", "remarks", "order", "createdAt"])
        && request.resource.data.task is string
        && request.resource.data.task.size() > 0
        && request.resource.data.task.size() <= 1200
        && request.resource.data.status in ["Pending", "Done"]
        && request.resource.data.remarks is string
        && request.resource.data.remarks.size() <= 1200
        && request.resource.data.order is int
        && request.resource.data.order >= 0;
      allow delete: if false;
    }
    match /myTevRecords/{recordId} {
      function hasValidEvidenceOptions(recordData) {
        return !recordData.keys().hasAny(["evidenceOfTravelOptions"])
          || (recordData.evidenceOfTravelOptions is list
            && recordData.evidenceOfTravelOptions.size() <= 10
            && recordData.evidenceOfTravelOptions.hasOnly(["Approved Itinerary of Travel", "Approved PTR", "Approved Travel Orders", "Boarding Pass", "Boat Ticket", "Bus Ticket", "Certificate of Appearance", "COENRR", "GSS Certification", "Plane Ticket"]));
      }
      function hasValidCertificationOfTravel(recordData) {
        return !recordData.keys().hasAny(["certificationOfTravel"])
          || (recordData.certificationOfTravel is map
            && recordData.certificationOfTravel.keys().hasAll(["strictlyInAccordance", "cutShort", "cutShortAmount", "cutShortOrNo", "cutShortDate", "extended", "otherDeviation", "otherExplanation"])
            && recordData.certificationOfTravel.keys().hasOnly(["strictlyInAccordance", "cutShort", "cutShortAmount", "cutShortOrNo", "cutShortDate", "extended", "otherDeviation", "otherExplanation"])
            && recordData.certificationOfTravel.strictlyInAccordance is bool
            && recordData.certificationOfTravel.cutShort is bool
            && recordData.certificationOfTravel.cutShortAmount is string
            && recordData.certificationOfTravel.cutShortAmount.size() <= 32
            && recordData.certificationOfTravel.cutShortOrNo is string
            && recordData.certificationOfTravel.cutShortOrNo.size() <= 60
            && recordData.certificationOfTravel.cutShortDate is string
            && (recordData.certificationOfTravel.cutShortDate == "" || recordData.certificationOfTravel.cutShortDate.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$"))
            && recordData.certificationOfTravel.extended is bool
            && recordData.certificationOfTravel.otherDeviation is bool
            && recordData.certificationOfTravel.otherExplanation is string
            && recordData.certificationOfTravel.otherExplanation.size() <= 500);
      }
      function hasValidTevSharingMetadata(recordData) {
        return (!recordData.keys().hasAny(["sharedWith"])
            || (recordData.sharedWith is list && recordData.sharedWith.size() <= 18))
          && ((!recordData.keys().hasAny(["createdById", "sourceRecordId"]))
            || (recordData.keys().hasAll(["createdById", "sourceRecordId"])
              && recordData.createdById is string
              && recordData.sourceRecordId is string));
      }
      function isValidSharedMyTevProfile(recordData, ownerData) {
        let assignment = profileAssignment(ownerData);
        return recordData.profile.name == ownerData.name
          && recordData.profile.address == ownerData.address
          && recordData.profile.taxIdentificationNo == ownerData.taxIdentificationNo
          && recordData.profile.position == ownerData.position
          && (recordData.profile.unit == assignment
            || recordData.profile.unit == profileDivision(ownerData)
            || (assignment == "NUPAP" && recordData.profile.unit == "NUPA Program")
            || (assignment == "HVCDP Program" && recordData.profile.unit == "HVCD Program")
            || (assignment == "Halal Project" && recordData.profile.unit == "Halal Projects"));
      }
      function isAuthorizedSharedMyTevCopy(recordData) {
        let sourcePath = /databases/$(database)/documents/myTevRecords/$(recordData.sourceRecordId);
        let ownerPath = /databases/$(database)/documents/users/$(recordData.ownerId);
        return recordData.ownerId is string
          && recordData.ownerId != request.auth.uid
          && recordData.createdById == request.auth.uid
          && recordData.sourceRecordId is string
          && existsAfter(sourcePath)
          && exists(ownerPath)
          && getAfter(sourcePath).data.ownerId == request.auth.uid
          && getAfter(sourcePath).data.sharedWith is list
          && recordData.ownerId in getAfter(sourcePath).data.sharedWith
          && isValidSharedMyTevProfile(recordData, get(ownerPath).data)
          && recordData.month == getAfter(sourcePath).data.month
          && recordData.officialStation == getAfter(sourcePath).data.officialStation
          && recordData.evidenceOfTravel == getAfter(sourcePath).data.evidenceOfTravel
          && recordData.evidenceOfTravelOptions == getAfter(sourcePath).data.evidenceOfTravelOptions
          && recordData.certificationOfTravel == getAfter(sourcePath).data.certificationOfTravel
          && recordData.divisionName == getAfter(sourcePath).data.divisionName
          && recordData.itineraries == getAfter(sourcePath).data.itineraries;
      }
      function isValidMyTevRecord(recordData) {
        return recordData.keys().hasAll(["ownerId", "profile", "month", "officialStation", "travelReferences", "evidenceOfTravel", "divisionName", "itineraries", "createdAt"])
          && recordData.keys().hasOnly(["ownerId", "sharedWith", "createdById", "sourceRecordId", "profile", "month", "officialStation", "travelReferences", "evidenceOfTravel", "evidenceOfTravelOptions", "certificationOfTravel", "divisionName", "itineraries", "createdAt"])
          && hasValidTevSharingMetadata(recordData)
          && hasValidEvidenceOptions(recordData)
          && hasValidCertificationOfTravel(recordData)
          && recordData.ownerId == request.auth.uid
          && recordData.profile is map
          && recordData.profile.keys().hasOnly(["name", "address", "taxIdentificationNo", "position", "unit"])
          && recordData.profile.name is string
          && recordData.profile.name.size() > 0
          && recordData.profile.name.size() <= 120
          && recordData.profile.address is string
          && recordData.profile.address.size() > 0
          && recordData.profile.address.size() <= 200
          && recordData.profile.taxIdentificationNo is string
          && recordData.profile.taxIdentificationNo.size() > 0
          && recordData.profile.taxIdentificationNo.size() <= 30
          && recordData.profile.position is string
          && recordData.profile.position.size() > 0
          && recordData.profile.position.size() <= 120
          && recordData.profile.unit is string
          && recordData.month is string
          && recordData.month.matches("^[0-9]{4}-(0[1-9]|1[0-2])$")
          && recordData.officialStation in ["Department of Agriculture - Regional Office XIII", "DA - Integrated Laboratories Division Caraga"]
          && recordData.travelReferences is list
          && recordData.travelReferences.size() > 0
          && recordData.travelReferences.size() <= 8
          && recordData.evidenceOfTravel is string
          && recordData.evidenceOfTravel.size() > 0
          && recordData.evidenceOfTravel.size() <= 240
          && recordData.divisionName in ["Field Operations Division", "Planning, Monitoring and Evaluation Division", "Administrative Division", "Finance Division", "Agribusiness and Marketing Assistance Division", "Regional Agricultural Engineering Division", "Research Division", "Regulatory Division", "Integrated Laboratories Division"]
          && recordData.itineraries is list
          && recordData.itineraries.size() > 0
          && recordData.itineraries.size() <= 8
          && recordData.createdAt is timestamp;
      }
      allow read: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasAll(["ownerId", "profile", "month", "officialStation", "travelReferences", "evidenceOfTravel", "divisionName", "itineraries", "createdAt"])
        && request.resource.data.keys().hasOnly(["ownerId", "sharedWith", "createdById", "sourceRecordId", "profile", "month", "officialStation", "travelReferences", "evidenceOfTravel", "evidenceOfTravelOptions", "certificationOfTravel", "divisionName", "itineraries", "createdAt"])
        && hasValidTevSharingMetadata(request.resource.data)
        && hasValidEvidenceOptions(request.resource.data)
        && hasValidCertificationOfTravel(request.resource.data)
        && (request.resource.data.ownerId == request.auth.uid || isAuthorizedSharedMyTevCopy(request.resource.data))
        && request.resource.data.profile is map
        && request.resource.data.profile.keys().hasOnly(["name", "address", "taxIdentificationNo", "position", "unit"])
        && request.resource.data.profile.name is string
        && request.resource.data.profile.name.size() > 0
        && request.resource.data.profile.name.size() <= 120
        && request.resource.data.profile.address is string
        && request.resource.data.profile.address.size() > 0
        && request.resource.data.profile.address.size() <= 200
        && request.resource.data.profile.taxIdentificationNo is string
        && request.resource.data.profile.taxIdentificationNo.size() > 0
        && request.resource.data.profile.taxIdentificationNo.size() <= 30
        && request.resource.data.profile.position is string
        && request.resource.data.profile.position.size() > 0
        && request.resource.data.profile.position.size() <= 120
        && request.resource.data.profile.unit is string
        && request.resource.data.month is string
        && request.resource.data.month.matches("^[0-9]{4}-(0[1-9]|1[0-2])$")
        && request.resource.data.officialStation in ["Department of Agriculture - Regional Office XIII", "DA - Integrated Laboratories Division Caraga"]
        && request.resource.data.travelReferences is list
        && request.resource.data.travelReferences.size() > 0
        && request.resource.data.travelReferences.size() <= 8
        && request.resource.data.evidenceOfTravel is string
        && request.resource.data.evidenceOfTravel.size() > 0
        && request.resource.data.evidenceOfTravel.size() <= 240
        && request.resource.data.divisionName in ["Field Operations Division", "Planning, Monitoring and Evaluation Division", "Administrative Division", "Finance Division", "Agribusiness and Marketing Assistance Division", "Regional Agricultural Engineering Division", "Research Division", "Regulatory Division", "Integrated Laboratories Division"]
        && request.resource.data.itineraries is list
        && request.resource.data.itineraries.size() > 0
        && request.resource.data.itineraries.size() <= 8
        && request.resource.data.createdAt is timestamp;
      allow update: if isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.month == resource.data.month
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidMyTevRecord(request.resource.data);
      allow delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
    }
    match /myDriveFiles/{fileId} {
      allow read: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && fileId.size() == 36
        && request.resource.data.keys().hasAll(["ownerId", "name", "mimeType", "size", "fileURL", "fileKey", "uploadedAt"])
        && request.resource.data.keys().hasOnly(["ownerId", "name", "mimeType", "size", "fileURL", "fileKey", "uploadedAt"])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 255
        && request.resource.data.mimeType is string
        && request.resource.data.mimeType.size() <= 200
        && request.resource.data.size is int
        && request.resource.data.size >= 0
        && request.resource.data.size <= 31457280
        && request.resource.data.fileURL is string
        && request.resource.data.fileURL.size() <= 500
        && request.resource.data.fileKey is string
        && request.resource.data.fileKey.size() > 0
        && request.resource.data.fileKey.size() <= 200
        && request.resource.data.uploadedAt is timestamp;
      allow update: if isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160;
      allow delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
    }
    match /accomplishmentReports/{reportId} {
      allow read: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.resource.data.ownerId == request.auth.uid
        && reportId == request.auth.uid + "_" + request.resource.data.month + (request.resource.data.cycle == 1 ? "_first" : "_second")
        && request.resource.data.keys().hasAll(["ownerId", "month", "cycle", "startDay", "endDay", "activities", "unit", "preparedName", "preparedPosition", "signatoryName", "signatoryPosition", "signatoryDivision", "createdAt"])
        && request.resource.data.keys().hasOnly(["ownerId", "month", "cycle", "startDay", "endDay", "activities", "unit", "preparedName", "preparedPosition", "signatoryName", "signatoryPosition", "signatoryDivision", "createdAt"])
        && request.resource.data.month is string
        && request.resource.data.month.size() == 7
        && ((request.resource.data.cycle == 1
          && request.resource.data.startDay == 1
          && request.resource.data.endDay == 15)
          || (request.resource.data.cycle == 2
          && request.resource.data.startDay == 16
          && request.resource.data.endDay >= 28
          && request.resource.data.endDay <= 31))
        && request.resource.data.activities is list
        && request.resource.data.activities.size() > 0
        && request.resource.data.activities.size() <= 30
        && request.resource.data.unit in ["AMIA", "AGRISTAT", "DRRM", "4K", "APCO - ADN", "APCO - ADS", "APCO - PDI", "APCO - SDN", "APCO - SDS", "Corn Program", "ELCAC", "Extension and Partnership", "F2C2", "GAD", "HVCDP Program", "Livestock Program", "NUPAP", "Organic Agriculture Program", "Rice Program", "RSBSA", "SAAD", "Administrative Division", "Agribusiness and Marketing Assistance Division", "Field Operations Division", "Finance Division", "Integrated Laboratories Division", "Planning, Monitoring and Evaluation Division", "Regional Agricultural Engineering Division", "Regulatory Division", "Research Division", "Regional Executive Director", "RTD for Operations", "RTD for Research and Regulations"]
        && request.resource.data.preparedName is string
        && request.resource.data.preparedName.size() > 0
        && request.resource.data.preparedName.size() <= 120
        && request.resource.data.preparedPosition is string
        && request.resource.data.preparedPosition.size() > 0
        && request.resource.data.preparedPosition.size() <= 120
        && request.resource.data.signatoryName is string
        && request.resource.data.signatoryName.size() > 0
        && request.resource.data.signatoryName.size() <= 120
        && request.resource.data.signatoryPosition in ["Chief", "OIC", "Regional Executive Director", "RTD for Operations", "RTD for Research and Regulations"]
        && request.resource.data.signatoryDivision in ["", "Administrative Division", "Agribusiness and Marketing Assistance Division", "Field Operations Division", "Finance Division", "Integrated Laboratories Division", "Planning, Monitoring and Evaluation Division", "Regional Agricultural Engineering Division", "Regulatory Division", "Research Division"]
        && request.resource.data.createdAt is timestamp;
      allow update: if isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && isAccomplishmentReportEditable(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(["activities"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activities"])
        && request.resource.data.activities is list
        && request.resource.data.activities.size() > 0
        && request.resource.data.activities.size() <= 30;
      allow delete: if false;
    }
  }
}
