rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isEmailVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function isSuperAdmin() {
      let userPath = currentUserPath();
      return isEmailVerified() && (request.auth.token.email == "rjamescute2@gmail.com"
        || (exists(userPath)
          && get(userPath).data.get("accountRole", "") == "superadmin"
          && get(userPath).data.get("accountStatus", "Approved") == "Approved"));
    }
    function isVerifiedUser() {
      let userPath = currentUserPath();
      return isEmailVerified() && (isSuperAdmin()
        // Legacy profiles may store accountStatus as null. The app treats
        // both a missing and null status as Approved.
        || (exists(userPath) && get(userPath).data.get("accountStatus", "Approved") in ["Approved", null]));
    }
    function canCreateFodCertificateTemplates() {
      let userPath = currentUserPath();
      let profile = exists(userPath) ? get(userPath).data : {};
      return isVerifiedUser()
        && exists(userPath)
        && ((normalizedAccountRole(profile) in ["regular", "user"]
            && profileAssignment(profile) in ["AGRISTAT", "AMIA", "DRRM"])
          || (normalizedAccountRole(profile) == "admin"
            && profileDivision(profile) == "Field Operations Division"));
    }
    function isCalendarActivityAdminAccount(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return userId is string
        && exists(userPath)
        && normalizedAccountRole(get(userPath).data) == "admin"
        && get(userPath).data.get("accountStatus", "Approved") in ["Approved", null];
    }
    function isCalendarActivityAdminSignatory(signatory) {
      return signatory is map
        && signatory.userId is string && signatory.userId.size() > 0 && signatory.userId.size() <= 128
        && signatory.name is string && signatory.name.size() > 0 && signatory.name.size() <= 120
        && signatory.designation is string && signatory.designation.size() <= 120
        && signatory.position is string && signatory.position.size() <= 120
        && signatory.assignment is string && signatory.assignment.size() <= 160;
    }
    function isCalendarActivityApprover(signatory) {
      return signatory is map
        && signatory.name is string && signatory.name.size() > 0 && signatory.name.size() <= 120
        && signatory.designation in ["Regional Executive Director", "RTD for Operations", "RTD for Research and Regulation"];
    }
    function isFodCalendarApproverProfile(profile, designation) {
      return normalizedAccountRole(profile) == "admin"
        && profile.get("office", "") == "Division"
        && profile.get("division", "") == "Field Operations Division"
        && profile.get("unit", "") == "Field Operations Division"
        && profile.get("designation", "") == designation;
    }
    function isFodCalendarApproverAccount(userId, designation) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      let profile = get(userPath).data;
      return profile.get("accountStatus", "Approved") in ["Approved", null]
        && isFodCalendarApproverProfile(profile, designation);
    }
    function isCurrentFodCalendarApprover(designation) {
      return isFodCalendarApproverProfile(get(currentUserPath()).data, designation);
    }
    function isFodCalendarRegularOwner(profile) {
      let version = profile.get("profileFieldsVersion", 0);
      let office = profileOffice(profile);
      let assignment = profileAssignment(profile);
      let legacyRegionalFodProfile = version < 4
        && office == "Regional Field Office"
        && assignment in ["AGRISTAT", "DRRM", "AMIA", "Field Operations Division"];
      return normalizedAccountRole(profile) in ["regular", "user"]
        && (office in ["Division", "Field Operations Division"] || legacyRegionalFodProfile)
        && profileDivision(profile) == "Field Operations Division"
        && assignment in ["AGRISTAT", "DRRM", "AMIA"];
    }
    function isFodCalendarWorkflowCreate(data) {
      return data.approvalWorkflow == "fod-calendar"
        && data.approvalStage == "owner-initial"
        && data.status == "Pending"
        && data.initialSignerId != data.chiefSignerId
        && isCalendarActivityAdminAccount(data.initialSignerId)
        && isCalendarActivityAdminAccount(data.chiefSignerId)
        && data.checkedBy.userId == data.initialSignerId
        && data.notedBy.userId == data.chiefSignerId
        && data.checkedBy.designation == "AGRISTAT/DRRM/AMIA Project Leader"
        && data.notedBy.designation == "Chief"
        && data.affixInitialSignature == "No"
        && !data.keys().hasAny(["affixInitialSignatureURL", "affixInitialSignatureName", "affixInitialSignatureAt", "affixCheckedSignature", "affixCheckedSignatureURL", "affixCheckedSignatureName", "affixCheckedSignatureAt", "affixNotedSignature", "affixNotedSignatureURL", "affixNotedSignatureName", "affixNotedSignatureAt"]);
    }
    function validProfileSignatureAffix(data, signatureKey, urlKey, nameKey, timestampKey, profileUrlKey) {
      let profile = get(currentUserPath()).data;
      let url = data.get(urlKey, "");
      let name = data.get(nameKey, "");
      return data.get(signatureKey, "") == "Yes"
        && url.size() > 0
        && url == profile.get(profileUrlKey, "")
        && name.size() > 0
        && name == profile.get("name", "")
        && data.get(timestampKey, null) == request.time;
    }
    function isFodSignatureTransition(stage, actorKey, designation, signatureKey, profileURLKey, nextStage, allowNo) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.get("approvalStage", "") == stage
        && resource.data.get(actorKey, "") == request.auth.uid
        && (designation == "" || isCurrentFodCalendarApprover(designation))
        && changed.hasOnly([signatureKey, signatureKey + "URL", signatureKey + "Name", signatureKey + "At", "approvalStage"])
        && ((allowNo && request.resource.data.get(signatureKey, "") == "No" && changed.hasOnly([signatureKey]))
          || (validProfileSignatureAffix(request.resource.data, signatureKey, signatureKey + "URL", signatureKey + "Name", signatureKey + "At", profileURLKey)
            && request.resource.data.approvalStage == nextStage));
    }
    function isFodCalendarWorkflowSignatureUpdate() {
      return resource.data.get("approvalWorkflow", "") == "fod-calendar"
        && resource.data.status == "Pending"
        && (isFodSignatureTransition("owner-initial", "ownerId", "", "affixInitialSignature", "fullSignatureURL", "project-leader", true)
          || isFodSignatureTransition("project-leader", "initialSignerId", "AGRISTAT/DRRM/AMIA Project Leader", "affixCheckedSignature", "fullSignatureURL", "chief", true)
          || isFodSignatureTransition("chief", "chiefSignerId", "Chief", "affixNotedSignature", "fullSignatureURL", "returned", true));
    }
    function isFodOwnerApprovalWorkflowCreate(data, workflow, stage) {
      let owner = get(currentUserPath()).data;
      return data.get("approvalWorkflow", "") == workflow
        && data.get("approvalStage", "") == stage
        && isFodCalendarRegularOwner(owner)
        && isFodCalendarApproverAccount(data.initialSignerId, "AGRISTAT/DRRM/AMIA Project Leader")
        && isFodCalendarApproverAccount(data.chiefSignerId, "Chief")
        && data.initialSignerId != data.chiefSignerId
        && data.get("affixInitialSignature", "No") == "No"
        && data.get("affixChiefSignature", "No") == "No";
    }
    function isFodMyARWorkflowCreate(data) {
      let owner = get(currentUserPath()).data;
      let initialPath = /databases/$(database)/documents/users/$(data.initialSignerId);
      let chiefPath = /databases/$(database)/documents/users/$(data.chiefSignerId);
      let initial = get(initialPath).data;
      let chief = get(chiefPath).data;
      return data.get("approvalWorkflow", "") == "fod-myar"
        && data.get("approvalStage", "") == "owner-full"
        && owner.accountRole == "regular"
        && owner.get("accountStatus", "Approved") in ["Approved", null]
        && owner.office == "Division"
        && owner.division == "Field Operations Division"
        && owner.unit in ["AGRISTAT", "DRRM", "AMIA"]
        && data.unit == owner.unit
        && data.initialSignerId is string
        && data.chiefSignerId is string
        && data.initialSignerId != data.chiefSignerId
        && exists(initialPath)
        && initial.accountRole == "admin"
        && initial.get("accountStatus", "Approved") in ["Approved", null]
        && initial.office == "Division"
        && initial.division == "Field Operations Division"
        && initial.unit == "Field Operations Division"
        && initial.designation == "AGRISTAT/DRRM/AMIA Project Leader"
        && exists(chiefPath)
        && chief.accountRole == "admin"
        && chief.get("accountStatus", "Approved") in ["Approved", null]
        && chief.office == "Division"
        && chief.division == "Field Operations Division"
        && chief.unit == "Field Operations Division"
        && chief.designation == "Chief"
        && data.get("affixInitialSignature", "No") == "No"
        && data.get("affixChiefSignature", "No") == "No";
    }
    function isFodMyARWorkflowSignatureUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.get("approvalWorkflow", "") == "fod-myar"
        && (isFodSignatureTransition("owner-full", "ownerId", "", "affixSignature", "fullSignatureURL", "owner-full", true)
          || (resource.data.get("approvalStage", "") == "owner-full"
            && resource.data.ownerId == request.auth.uid
            && resource.data.get("affixSignature", "") == "Yes"
            && request.resource.data.get("approvalStage", "") == "project-leader"
            && changed.hasOnly(["approvalStage"]))
          || isFodSignatureTransition("project-leader", "initialSignerId", "AGRISTAT/DRRM/AMIA Project Leader", "affixInitialSignature", "initialSignatureURL", "chief", false)
          || isFodSignatureTransition("chief", "chiefSignerId", "Chief", "affixChiefSignature", "fullSignatureURL", "returned", false));
    }
    function isFodLeaveWorkflowSignatureUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.get("approvalWorkflow", "") == "fod-myleave"
        && resource.data.status == "Pending"
        && (isFodSignatureTransition("owner-full", "ownerId", "", "affixSignature", "fullSignatureURL", "owner-full", true)
          || (resource.data.get("approvalStage", "") == "owner-full"
            && resource.data.ownerId == request.auth.uid
            && resource.data.get("affixSignature", "") == "Yes"
            && request.resource.data.get("approvalStage", "") == "project-leader"
            && changed.hasOnly(["approvalStage"]))
          || isFodSignatureTransition("project-leader", "initialSignerId", "AGRISTAT/DRRM/AMIA Project Leader", "affixInitialSignature", "initialSignatureURL", "chief", true)
          || isFodSignatureTransition("chief", "chiefSignerId", "Chief", "affixChiefSignature", "fullSignatureURL", "returned", true));
    }
    function isFodLegacyWorkflowMigration(workflow, updatesStatus) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let data = request.resource.data;
      return resource.data.get("approvalWorkflow", "") != workflow
        && resource.data.ownerId == request.auth.uid
        && isFodCalendarRegularOwner(get(currentUserPath()).data)
        && resource.data.get("affixSignature", "") == "Yes"
        && data.get("approvalWorkflow", "") == workflow
        && data.get("approvalStage", "") == "project-leader"
        && data.get("initialSignerId", "") is string
        && data.get("chiefSignerId", "") is string
        && data.initialSignerId != data.chiefSignerId
        && data.get("affixInitialSignature", "") == "No"
        && data.get("affixChiefSignature", "") == "No"
        && (updatesStatus
          ? resource.data.status in ["Pending", "Approved"]
            && data.get("status", "") == "Pending"
            && changed.hasOnly(["approvalWorkflow", "approvalStage", "initialSignerId", "chiefSignerId", "affixInitialSignature", "affixChiefSignature", "status"])
          : changed.hasOnly(["approvalWorkflow", "approvalStage", "initialSignerId", "chiefSignerId", "affixInitialSignature", "affixChiefSignature"]));
    }
    function profileOffice(profile) {
      let version = profile.get("profileFieldsVersion", 0);
      let office = profile.get("office", "");
      let legacyProjectProgram = profile.get("projectProgram", "");
      let legacyUnit = profile.get("unit", "");
      let rawOffice = version >= 2 && office is string && office.size() > 0 ? office
        : legacyProjectProgram is string && legacyProjectProgram.size() > 0 ? legacyProjectProgram
        : legacyUnit is string && legacyUnit.size() > 0 ? legacyUnit
        : office;
      return version >= 4 ? office
        : rawOffice == "Field Operations Division (ILD)"
          || rawOffice in ["AGRISTAT", "AMIA", "DRRM", "FOD-AGRISTAT", "FOD-AMIA", "FOD-DRRM"]
          || (rawOffice is string && rawOffice.matches("^FOD-.*"))
          ? "Field Operations Division"
          : rawOffice;
    }
    function profileAssignment(profile) {
      let version = profile.get("profileFieldsVersion", 0);
      let assignment = profile.get("assignment", "");
      let projectProgram = profile.get("projectProgram", "");
      let legacyUnit = profile.get("unit", "");
      let legacyOffice = profile.get("office", "");
      let division = profile.get("division", "");
      let rawAssignment = version >= 4 ? (legacyUnit is string && legacyUnit.size() > 0 ? legacyUnit : division)
        : version >= 3 ? assignment
        : version == 2 && projectProgram is string && projectProgram.size() > 0 ? projectProgram
        : version == 2 && legacyUnit is string && legacyUnit.size() > 0 ? legacyUnit
        : legacyUnit is string && legacyUnit.size() > 0 ? legacyUnit
        : legacyOffice is string && legacyOffice.size() > 0 ? legacyOffice
        : projectProgram;
      return rawAssignment == "AGRISTAT-AMIA-DRRM" ? ""
        : rawAssignment in ["FOD-AGRISTAT"] ? "AGRISTAT"
        : rawAssignment in ["FOD-AMIA"] ? "AMIA"
        : rawAssignment in ["FOD-DRRM"] ? "DRRM"
        : rawAssignment is string && rawAssignment.size() > 0 ? rawAssignment
        : legacyOffice in ["AGRISTAT", "FOD-AGRISTAT"] ? "AGRISTAT"
        : legacyOffice in ["AMIA", "FOD-AMIA"] ? "AMIA"
        : legacyOffice in ["DRRM", "FOD-DRRM"] ? "DRRM"
        : "";
    }
    function profileDivision(profile) {
      let version = profile.get("profileFieldsVersion", 0);
      let office = profileOffice(profile);
      let division = profile.get("division", "");
      let assignment = profileAssignment(profile);
      return version >= 4 ? division
        : office == "Field Operations Division" ? "Field Operations Division"
        : office == "Division" && assignment is string && assignment.lower() in ["agristat", "drrm", "amia", "field operations division"] ? "Field Operations Division"
        : office == "Regional Field Office" && assignment is string && assignment.lower() in ["agristat", "drrm", "amia", "field operations division"] ? "Field Operations Division"
        : office == "Regional Field Office" ? assignment
        : office;
    }
    function signedInOffice() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? profileOffice(get(userPath).data) : null;
    }
    function signedInUnit() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? profileAssignment(get(userPath).data) : null;
    }
    function normalizedAccountRole(profile) {
      let role = profile.get("accountRole", "");
      return role is string ? role.lower() : "";
    }
    function canUploadInitialSignature(profile) {
      let role = normalizedAccountRole(profile);
      return role in ["admin", "superadmin"]
        || (role in ["regular", "user"] && profile.get("designation", "") in ["Chief", "OIC"]);
    }
    function sameTextIgnoreCase(value, expected) {
      return value is string && expected is string && value.lower() == expected.lower();
    }
    function ownerUnitMatchesSignedIn(data) {
      return sameTextIgnoreCase(data.get("ownerUnit", ""), signedInUnit());
    }
    function isCleaningTaskUnit(unit) {
      return unit in ["AGRISTAT", "AMIA", "DRRM"];
    }
    function isCleaningTaskRegularProfile(profile) {
      return normalizedAccountRole(profile) in ["regular", "user"]
        && profile.get("office", "") == "Division"
        && profile.get("division", "") == "Field Operations Division"
        && isCleaningTaskUnit(profile.get("unit", ""));
    }
    function canReadCleaningTasks() {
      let userPath = currentUserPath();
      return isVerifiedUser() && exists(userPath)
        && get(userPath).data.get("accountStatus", "Approved") == "Approved"
        && (isCleaningTaskRegularProfile(get(userPath).data)
          || isFodCalendarApproverProfile(get(userPath).data, "AGRISTAT/DRRM/AMIA Project Leader"));
    }
    function canUploadCleaningTask(unit) {
      let userPath = currentUserPath();
      return canReadCleaningTasks()
        && (isFodCalendarApproverProfile(get(userPath).data, "AGRISTAT/DRRM/AMIA Project Leader")
          || (isCleaningTaskRegularProfile(get(userPath).data) && get(userPath).data.get("unit", "") == unit));
    }
    function validCleaningTaskAssignment(data, weekStart) {
      return data.keys().hasAll(["weekStart", "month", "weekNumber", "unit", "startAt", "endAt", "assignedBy", "assignedAt"])
        && data.keys().hasOnly(["weekStart", "month", "weekNumber", "unit", "startAt", "endAt", "assignedBy", "assignedAt"])
        && weekStart.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && data.weekStart == weekStart
        && data.month.matches("^[0-9]{4}-(0[1-9]|1[0-2])$")
        && data.weekNumber is int && data.weekNumber >= 1 && data.weekNumber <= 6
        && isCleaningTaskUnit(data.unit)
        && data.startAt is timestamp && data.endAt is timestamp && data.startAt < data.endAt
        && data.assignedBy == request.auth.uid
        && data.assignedAt == request.time;
    }
    function isCurrentCleaningTaskAssignment(weekStart, unit) {
      let assignmentPath = /databases/$(database)/documents/cleaningTaskAssignments/$(weekStart);
      return exists(assignmentPath)
        && get(assignmentPath).data.get("weekStart", "") == weekStart
        && get(assignmentPath).data.get("unit", "") == unit
        && get(assignmentPath).data.get("startAt", request.time) <= request.time
        && request.time < get(assignmentPath).data.get("endAt", request.time);
    }
    function validCleaningTaskImage(data, imageId) {
      return data.keys().hasAll(["unit", "imageURL", "fileKey", "previousFileKey", "previousFileOwnerId", "uploaderId", "uploaderName", "submittedWeekStart", "location", "uploadedAt"])
        && data.keys().hasOnly(["unit", "imageURL", "fileKey", "previousFileKey", "previousFileOwnerId", "uploaderId", "uploaderName", "submittedWeekStart", "location", "uploadedAt"])
        && isCleaningTaskUnit(data.unit)
        && (imageId == "current" || imageId == data.unit)
        && data.imageURL is string && data.imageURL.size() <= 2048
        && data.fileKey is string && data.fileKey.matches("^[A-Za-z0-9_.-]{1,128}$")
        && (data.imageURL == "https://utfs.io/f/" + data.fileKey
          || data.imageURL.matches("^https://[A-Za-z0-9-]+\\.ufs\\.sh/f/" + data.fileKey + "$"))
        && data.previousFileKey is string && data.previousFileKey.size() <= 128
        && data.previousFileOwnerId is string && data.previousFileOwnerId.size() <= 128
        && data.uploaderId is string && data.uploaderId.size() > 0 && data.uploaderId.size() <= 128
        && data.uploaderName is string && data.uploaderName.size() > 0 && data.uploaderName.size() <= 120
        && data.submittedWeekStart is string && data.submittedWeekStart.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && data.location is string && data.location.size() > 0 && data.location.size() <= 180
        && data.uploadedAt is timestamp && data.uploadedAt == request.time;
    }
    function signedInDivision() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? profileDivision(get(userPath).data) : null;
    }
    function personnelScopeOffice(profile) {
      return profileOffice(profile);
    }
    function personnelScopeAssignment(profile) {
      return profileAssignment(profile);
    }
    function samePersonnelScope(firstProfile, secondProfile) {
      let firstOffice = personnelScopeOffice(firstProfile);
      let secondOffice = personnelScopeOffice(secondProfile);
      let firstDivision = profileDivision(firstProfile);
      let secondDivision = profileDivision(secondProfile);
      let firstAssignment = personnelScopeAssignment(firstProfile);
      let secondAssignment = personnelScopeAssignment(secondProfile);
      return firstOffice == secondOffice
        && firstDivision == secondDivision
        && firstAssignment is string && firstAssignment.size() > 0
        && firstAssignment == secondAssignment;
    }
    function sameCalendarActivityUnit(firstProfile, secondProfile) {
      let firstUnit = profileAssignment(firstProfile);
      let secondUnit = profileAssignment(secondProfile);
      return firstUnit is string && firstUnit.size() > 0
        && secondUnit is string && firstUnit == secondUnit;
    }
    function sameCalendarActivityDivision(firstProfile, secondProfile) {
      let firstDivision = profileDivision(firstProfile);
      let secondDivision = profileDivision(secondProfile);
      return firstDivision is string && firstDivision.size() > 0
        && secondDivision is string && firstDivision == secondDivision;
    }
    function calendarRecipientInOwnerScope(calendarId, recipientId) {
      let calendarRef = /databases/$(database)/documents/calendarOfActivities/$(calendarId);
      let ownerId = get(calendarRef).data.ownerId;
      let ownerPath = /databases/$(database)/documents/users/$(ownerId);
      let recipientPath = /databases/$(database)/documents/users/$(recipientId);
      return exists(calendarRef)
        && exists(ownerPath)
        && exists(recipientPath)
        && ((normalizedAccountRole(get(recipientPath).data) in ["regular", "user"]
            && sameCalendarActivityUnit(get(ownerPath).data, get(recipientPath).data))
          || (normalizedAccountRole(get(recipientPath).data) == "admin"
            && sameCalendarActivityDivision(get(ownerPath).data, get(recipientPath).data)));
    }
    function isCalendarOwnerOrSameUnit(calendarId) {
      let calendarRef = /databases/$(database)/documents/calendarOfActivities/$(calendarId);
      return isVerifiedUser()
        && exists(calendarRef)
        && (get(calendarRef).data.ownerId == request.auth.uid
          || (exists(/databases/$(database)/documents/users/$(get(calendarRef).data.ownerId))
            && samePersonnelScope(get(currentUserPath()).data,
              get(/databases/$(database)/documents/users/$(get(calendarRef).data.ownerId)).data)));
    }
    function ownerUnitCanBeUpdated() {
      return (resource.data.keys().hasAny(["ownerUnit"])
          && request.resource.data.keys().hasAny(["ownerUnit"])
          && request.resource.data.ownerUnit == resource.data.ownerUnit)
        || (!resource.data.keys().hasAny(["ownerUnit"])
          && (!request.resource.data.keys().hasAny(["ownerUnit"])
            || request.resource.data.ownerUnit == signedInUnit()))
        || (resource.data.get("ownerUnit", null) == null
          && request.resource.data.keys().hasAny(["ownerUnit"])
          && request.resource.data.ownerUnit == signedInUnit());
    }
    function isPersonalTravelOrder(order, recipientId) {
      return recipientId is string
        && recipientId.size() > 0
        && order.get("recipientId", "") == recipientId
        && order.get("recipientIds", []) is list
        && order.recipientIds.size() == 1
        && order.recipientIds[0] == recipientId
        && order.get("people", []) is list
        && order.people.size() == 1
        && order.people[0] is map
        && order.people[0].get("userId", "") == recipientId;
    }
    function canUpdateTravelOrderAsRecipient(order) {
      return isPersonalTravelOrder(order, request.auth.uid);
    }
    function isPermitAdmin() {
      let userPath = currentUserPath();
      return isVerifiedUser() && (isSuperAdmin()
        || (exists(userPath)
          && get(userPath).data.get("accountRole", request.auth.token.email == "gerlieantipaso27@gmail.com" ? "admin" : "regular") == "admin"));
    }
    function hasChiefDesignation(profile) {
      let designation = profile.get("designation", "");
      return designation == "Chief"
        || (designation is string && designation.matches("(^|; )Chief(; |$)"));
    }
    function isChiefCertificateAdmin() {
      let userPath = currentUserPath();
      return isVerifiedUser() && exists(userPath)
        && get(userPath).data.get("accountRole", request.auth.token.email == "gerlieantipaso27@gmail.com" ? "admin" : "regular") == "admin"
        && hasChiefDesignation(get(userPath).data);
    }
    function canReviewUnitCertificate(data) {
      let office = signedInOffice();
      let assignment = signedInUnit();
      let division = profileDivision(get(currentUserPath()).data);
      return isSuperAdmin() || (isChiefCertificateAdmin()
        && (data.get("unit", "") == office
          || data.get("unit", "") == assignment
          || (division == "Field Operations Division"
            && data.get("unit", "") in ["AMIA", "AGRISTAT", "DRRM"])));
    }
    function appearanceDivisionForOffice(office) {
      return office in ["AMIA", "FOD-AMIA"] ? "Agribusiness and Marketing Assistance Division"
        : office in ["AGRISTAT", "FOD-AGRISTAT"] ? "Planning, Monitoring and Evaluation Division"
        : office in ["DRRM", "FOD-DRRM"] ? "Disaster Risk Reduction and Management Division"
        : office;
    }
    function appearanceDivisionForProfile(profile) {
      let version = profile.get("profileFieldsVersion", 0);
      let office = profileOffice(profile);
      let assignment = profileAssignment(profile);
      return version >= 4 ? profileDivision(profile)
        : office == "Regional Field Office"
        ? assignment
        : office == "Field Operations Division" && assignment in ["AGRISTAT", "AMIA", "DRRM"]
          ? appearanceDivisionForOffice(assignment)
          : appearanceDivisionForOffice(office);
    }
    function isAppearanceChiefAdminRecipient(userId, division) {
      let profilePath = /databases/$(database)/documents/users/$(userId);
      return exists(profilePath)
        && get(profilePath).data.get("accountRole", "") == "admin"
        && get(profilePath).data.get("accountStatus", "Approved") == "Approved"
