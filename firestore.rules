          && (!request.resource.data.keys().hasAny(["taxIdentificationNo"]) || (request.resource.data.taxIdentificationNo is string && request.resource.data.taxIdentificationNo.size() > 0 && request.resource.data.taxIdentificationNo.size() <= 30))
          && (!request.resource.data.keys().hasAny(["designation"]) || (request.resource.data.designation is string && request.resource.data.designation.size() <= 2000)))
        || (isSuperAdmin()
          && userId != request.auth.uid
          && resource.data.get("isRootSuperAdmin", false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "firstName", "middleName", "lastName", "address", "position", "designation", "office", "division", "unit", "profileFieldsVersion"])
          && request.resource.data.keys().hasAll(["name", "position", "office", "division", "unit", "profileFieldsVersion"])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
          && request.resource.data.position is string && request.resource.data.position.size() <= 120
          && request.resource.data.office is string && request.resource.data.office.size() > 0 && request.resource.data.office.size() <= 120
          && request.resource.data.division is string && request.resource.data.division.size() > 0 && request.resource.data.division.size() <= 120
          && request.resource.data.unit is string && request.resource.data.unit.size() > 0 && request.resource.data.unit.size() <= 120
          && request.resource.data.profileFieldsVersion == 4
          && (!request.resource.data.keys().hasAny(["firstName"]) || (request.resource.data.firstName is string && request.resource.data.firstName.size() <= 60))
