        && (request.resource.data.get("approvalWorkflow", "") == "fod-myar"
          ? isFodMyARWorkflowCreate(request.resource.data)
          : !request.resource.data.keys().hasAny(["approvalWorkflow", "approvalStage", "initialSignerId", "chiefSignerId", "affixInitialSignature", "affixChiefSignature"]));
      allow update: if isVerifiedUser()
        && ((resource.data.get("approvalWorkflow", "") == "fod-myar"
            && (isFodMyARWorkflowSignatureUpdate()
              || (resource.data.ownerId == request.auth.uid
                && resource.data.get("approvalStage", "") == "owner-full"
                && isAccomplishmentReportEditable(resource.data)
                && request.resource.data.diff(resource.data).affectedKeys().hasAny(["activities"])
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activities"])
                && request.resource.data.activities is list
                && request.resource.data.activities.size() > 0
                && request.resource.data.activities.size() <= 30)))
          || (resource.data.get("approvalWorkflow", "") != "fod-myar"
            && resource.data.ownerId == request.auth.uid
            && ((isAccomplishmentReportEditable(resource.data)
                && request.resource.data.diff(resource.data).affectedKeys().hasAny(["activities"])
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activities"])
                && request.resource.data.activities is list
                && request.resource.data.activities.size() > 0
                && request.resource.data.activities.size() <= 30)
              || isLegacyAccomplishmentReportSignatureUpdate()
              || isFodLegacyWorkflowMigration("fod-myar", false))));
      allow delete: if false;
    }
    match /accomplishmentReportNotifications/{notificationId} {
      function workflowNotificationMatches(data) {
        let path = /databases/$(database)/documents/accomplishmentReports/$(data.reportId);
        let report = getAfter(path).data;
        return existsAfter(path) && report.get("approvalWorkflow", "") == "fod-myar"
          && report.approvalStage in ["project-leader", "chief", "returned"]
          && request.auth.uid in [report.ownerId, report.initialSignerId, report.chiefSignerId]
          && data.recipientId in [report.ownerId, report.initialSignerId, report.chiefSignerId];
      }
      allow read: if isVerifiedUser() && resource.data.recipientId == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.resource.data.recipientId != request.auth.uid
        && workflowNotificationMatches(request.resource.data)
        && request.resource.data.read == false;
      allow update: if isVerifiedUser()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt"])
        && request.resource.data.read == true;
      allow delete: if false;
    }
  }
}
