rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isEmailVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function isSuperAdmin() {
      let userPath = currentUserPath();
      return isEmailVerified() && (request.auth.token.email == "rjamescute2@gmail.com"
        || (exists(userPath)
          && get(userPath).data.get("accountRole", "") == "superadmin"
          && get(userPath).data.get("accountStatus", "Approved") == "Approved"));
    }
    function isVerifiedUser() {
      let userPath = currentUserPath();
      return isEmailVerified() && (isSuperAdmin()
        || (exists(userPath) && get(userPath).data.get("accountStatus", "Approved") == "Approved"));
    }
    function isCalendarActivityAdminAccount(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return userId is string
        && exists(userPath)
        && get(userPath).data.get("accountRole", "") == "admin"
        && get(userPath).data.get("accountStatus", "Approved") in ["Approved", null];
    }
    function isCalendarActivityAdminSignatory(signatory) {
      return signatory is map
        && signatory.keys().hasAll(["userId", "name", "designation", "position", "assignment"])
        && signatory.keys().hasOnly(["userId", "name", "designation", "position", "assignment"])
        && signatory.userId is string && signatory.userId.size() > 0 && signatory.userId.size() <= 128
        && signatory.name is string && signatory.name.size() > 0 && signatory.name.size() <= 120
        && signatory.designation is string && signatory.designation.size() <= 120
        && signatory.position is string && signatory.position.size() <= 120
        && signatory.assignment is string && signatory.assignment.size() <= 160;
    }
    function isCalendarActivityApprover(signatory) {
      return signatory is map
        && signatory.keys().hasAll(["name", "designation"])
        && signatory.keys().hasOnly(["name", "designation"])
        && signatory.name is string && signatory.name.size() > 0 && signatory.name.size() <= 120
        && signatory.designation in ["Regional Executive Director", "RTD for Operations"];
    }
    function profileOffice(profile) {
      let version = profile.get("profileFieldsVersion", 0);
      let office = profile.get("office", "");
      let legacyProjectProgram = profile.get("projectProgram", "");
      let legacyUnit = profile.get("unit", "");
      let rawOffice = version >= 2 && office is string && office.size() > 0 ? office
        : legacyProjectProgram is string && legacyProjectProgram.size() > 0 ? legacyProjectProgram
        : legacyUnit is string && legacyUnit.size() > 0 ? legacyUnit
        : office;
      return version >= 4 ? office
        : rawOffice == "Field Operations Division (ILD)"
          || rawOffice in ["AGRISTAT", "AMIA", "DRRM", "FOD-AGRISTAT", "FOD-AMIA", "FOD-DRRM"]
          || (rawOffice is string && rawOffice.matches("^FOD-.*"))
          ? "Field Operations Division"
          : rawOffice;
    }
    function profileAssignment(profile) {
      let version = profile.get("profileFieldsVersion", 0);
      let assignment = profile.get("assignment", "");
      let projectProgram = profile.get("projectProgram", "");
      let legacyUnit = profile.get("unit", "");
      let legacyOffice = profile.get("office", "");
      let division = profile.get("division", "");
      let rawAssignment = version >= 4 ? (legacyUnit is string && legacyUnit.size() > 0 ? legacyUnit : division)
        : version >= 3 ? assignment
        : version == 2 && projectProgram is string && projectProgram.size() > 0 ? projectProgram
        : version == 2 && legacyUnit is string && legacyUnit.size() > 0 ? legacyUnit
        : legacyUnit is string && legacyUnit.size() > 0 ? legacyUnit
        : legacyOffice is string && legacyOffice.size() > 0 ? legacyOffice
        : projectProgram;
      return rawAssignment == "AGRISTAT-AMIA-DRRM" ? ""
        : rawAssignment in ["FOD-AGRISTAT"] ? "AGRISTAT"
        : rawAssignment in ["FOD-AMIA"] ? "AMIA"
        : rawAssignment in ["FOD-DRRM"] ? "DRRM"
        : rawAssignment is string && rawAssignment.size() > 0 ? rawAssignment
        : legacyOffice in ["AGRISTAT", "FOD-AGRISTAT"] ? "AGRISTAT"
        : legacyOffice in ["AMIA", "FOD-AMIA"] ? "AMIA"
        : legacyOffice in ["DRRM", "FOD-DRRM"] ? "DRRM"
        : "";
    }
    function profileDivision(profile) {
      let version = profile.get("profileFieldsVersion", 0);
      let office = profileOffice(profile);
      let division = profile.get("division", "");
      let assignment = profileAssignment(profile);
      return version >= 4 ? division
        : office == "Field Operations Division" ? "Field Operations Division"
        : office == "Regional Field Office" ? assignment
        : office;
    }
    function signedInOffice() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? profileOffice(get(userPath).data) : null;
    }
    function signedInUnit() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? profileAssignment(get(userPath).data) : null;
    }
    function isCleaningTaskUnit(unit) {
      return unit in ["AGRISTAT", "AMIA", "DRRM"];
    }
    function canReadCleaningTasks() {
      let userPath = currentUserPath();
      return isVerifiedUser() && exists(userPath)
        && get(userPath).data.get("accountStatus", "Approved") == "Approved"
        && (get(userPath).data.get("accountRole", "") in ["admin", "superadmin"]
          || (get(userPath).data.get("accountRole", "") in ["regular", "user"] && signedInUnit() in ["AGRISTAT", "AMIA", "DRRM"]));
    }
    function canUploadCleaningTask() {
      let userPath = currentUserPath();
      return isVerifiedUser() && exists(userPath)
        && get(userPath).data.get("accountStatus", "Approved") == "Approved"
        && ((get(userPath).data.get("accountRole", "") in ["regular", "user"] && signedInUnit() in ["AGRISTAT", "AMIA", "DRRM"])
          || (get(userPath).data.get("accountRole", "") == "admin"
            && get(userPath).data.get("designation", "") == "AGRISTAT/DRRM/AMIA Project Leader"));
    }
    function validCleaningTaskAssignment(data, weekStart) {
      return data.keys().hasAll(["weekStart", "month", "weekNumber", "unit", "startAt", "endAt", "assignedBy", "assignedAt"])
        && data.keys().hasOnly(["weekStart", "month", "weekNumber", "unit", "startAt", "endAt", "assignedBy", "assignedAt"])
        && weekStart.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && data.weekStart == weekStart
        && data.month.matches("^[0-9]{4}-(0[1-9]|1[0-2])$")
        && data.weekNumber is int && data.weekNumber >= 1 && data.weekNumber <= 6
        && isCleaningTaskUnit(data.unit)
        && data.startAt is timestamp && data.endAt is timestamp && data.startAt < data.endAt
        && data.assignedBy == request.auth.uid
        && data.assignedAt == request.time;
    }
    function isCurrentCleaningTaskAssignment(weekStart, unit) {
      let assignmentPath = /databases/$(database)/documents/cleaningTaskAssignments/$(weekStart);
      return exists(assignmentPath)
        && get(assignmentPath).data.get("weekStart", "") == weekStart
        && get(assignmentPath).data.get("unit", "") == unit
        && get(assignmentPath).data.get("startAt", request.time) <= request.time
        && request.time < get(assignmentPath).data.get("endAt", request.time);
    }
    function validCleaningTaskImage(data, unit) {
      return data.keys().hasAll(["unit", "imageURL", "fileKey", "previousFileKey", "previousFileOwnerId", "uploaderId", "uploaderName", "submittedWeekStart", "location", "uploadedAt"])
        && data.keys().hasOnly(["unit", "imageURL", "fileKey", "previousFileKey", "previousFileOwnerId", "uploaderId", "uploaderName", "submittedWeekStart", "location", "uploadedAt"])
        && isCleaningTaskUnit(unit)
        && data.unit == unit
        && data.imageURL is string && data.imageURL.size() <= 2048
        && data.fileKey is string && data.fileKey.matches("^[A-Za-z0-9_.-]{1,128}$")
        && (data.imageURL == "https://utfs.io/f/" + data.fileKey
          || data.imageURL.matches("^https://[A-Za-z0-9-]+\\.ufs\\.sh/f/" + data.fileKey + "$"))
        && data.previousFileKey is string && data.previousFileKey.size() <= 128
        && data.previousFileOwnerId is string && data.previousFileOwnerId.size() <= 128
        && data.uploaderId is string && data.uploaderId.size() > 0 && data.uploaderId.size() <= 128
        && data.uploaderName is string && data.uploaderName.size() > 0 && data.uploaderName.size() <= 120
        && data.submittedWeekStart is string && data.submittedWeekStart.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && data.location is string && data.location.size() > 0 && data.location.size() <= 180
        && data.uploadedAt is timestamp && data.uploadedAt == request.time;
    }
    function signedInDivision() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? profileDivision(get(userPath).data) : null;
    }
    function personnelScopeOffice(profile) {
      return profileOffice(profile);
    }
    function personnelScopeAssignment(profile) {
      return profileAssignment(profile);
    }
    function samePersonnelScope(firstProfile, secondProfile) {
      let firstOffice = personnelScopeOffice(firstProfile);
      let secondOffice = personnelScopeOffice(secondProfile);
      let firstDivision = profileDivision(firstProfile);
      let secondDivision = profileDivision(secondProfile);
      let firstAssignment = personnelScopeAssignment(firstProfile);
      let secondAssignment = personnelScopeAssignment(secondProfile);
      return firstOffice == secondOffice
        && firstDivision == secondDivision
        && firstAssignment is string && firstAssignment.size() > 0
        && firstAssignment == secondAssignment;
    }
    function calendarRecipientInOwnerScope(calendarId, recipientId) {
      let calendarRef = /databases/$(database)/documents/calendarOfActivities/$(calendarId);
      let ownerId = getAfter(calendarRef).data.ownerId;
      let ownerPath = /databases/$(database)/documents/users/$(ownerId);
      let recipientPath = /databases/$(database)/documents/users/$(recipientId);
      return existsAfter(calendarRef)
        && exists(ownerPath)
        && exists(recipientPath)
        && (samePersonnelScope(get(ownerPath).data, get(recipientPath).data)
          || (get(recipientPath).data.get("accountRole", "") == "admin"
            && get(recipientPath).data.get("accountStatus", "Approved") == "Approved"));
    }
    function isCalendarOwnerOrSameUnit(calendarId) {
      let calendarRef = /databases/$(database)/documents/calendarOfActivities/$(calendarId);
      return isVerifiedUser()
        && exists(calendarRef)
        && (get(calendarRef).data.ownerId == request.auth.uid
          || (exists(/databases/$(database)/documents/users/$(get(calendarRef).data.ownerId))
            && samePersonnelScope(get(currentUserPath()).data,
              get(/databases/$(database)/documents/users/$(get(calendarRef).data.ownerId)).data)));
    }
    function ownerUnitCanBeUpdated() {
      return (resource.data.keys().hasAny(["ownerUnit"])
          && request.resource.data.keys().hasAny(["ownerUnit"])
          && request.resource.data.ownerUnit == resource.data.ownerUnit)
        || (!resource.data.keys().hasAny(["ownerUnit"])
          && (!request.resource.data.keys().hasAny(["ownerUnit"])
            || request.resource.data.ownerUnit == signedInUnit()))
        || (resource.data.get("ownerUnit", null) == null
          && request.resource.data.keys().hasAny(["ownerUnit"])
          && request.resource.data.ownerUnit == signedInUnit());
    }
    function isPersonalTravelOrder(order, recipientId) {
      return recipientId is string
        && recipientId.size() > 0
        && order.get("recipientId", "") == recipientId
        && order.get("recipientIds", []) is list
        && order.recipientIds.size() == 1
        && order.recipientIds[0] == recipientId
        && order.get("people", []) is list
        && order.people.size() == 1
        && order.people[0] is map
        && order.people[0].get("userId", "") == recipientId;
    }
    function isNamedTravelOrderRecipient(order) {
      let userPath = currentUserPath();
      return exists(userPath)
        && order.get("people", []) is list
        && order.people.size() == 1
        && order.people[0] is map
        && order.people[0].get("name", "") is string
        && order.people[0].get("name", "").size() > 0
        && order.people[0].get("name", "").lower().replace("[.,'’-]+", " ").replace(" +", " ").trim()
          == get(userPath).data.get("name", "").lower().replace("[.,'’-]+", " ").replace(" +", " ").trim();
    }
    function canUpdateTravelOrderAsRecipient(order) {
      return isPersonalTravelOrder(order, request.auth.uid)
        || (order.get("recipientId", "") == request.auth.uid
          && order.get("people", []) is list
          && order.people.size() == 1)
        || (order.get("recipientIds", []) is list
          && request.auth.uid in order.recipientIds
          && order.get("people", []) is list
          && order.people.size() == 1)
        || (order.get("people", []) is list
          && order.people.size() == 1
          && order.people[0] is map
          && order.people[0].get("userId", "") == request.auth.uid)
        || isNamedTravelOrderRecipient(order);
    }
    function isPermitAdmin() {
      let userPath = currentUserPath();
      return isVerifiedUser() && (isSuperAdmin()
        || (exists(userPath)
          && get(userPath).data.get("accountRole", request.auth.token.email == "gerlieantipaso27@gmail.com" ? "admin" : "regular") == "admin"));
    }
    function hasChiefDesignation(profile) {
      let designation = profile.get("designation", "");
      return designation == "Chief"
        || (designation is string && designation.matches("(^|; )Chief(; |$)"));
    }
    function isChiefCertificateAdmin() {
      let userPath = currentUserPath();
      return isVerifiedUser() && exists(userPath)
        && get(userPath).data.get("accountRole", request.auth.token.email == "gerlieantipaso27@gmail.com" ? "admin" : "regular") == "admin"
        && hasChiefDesignation(get(userPath).data);
    }
    function canReviewUnitCertificate(data) {
      let office = signedInOffice();
      let assignment = signedInUnit();
      let division = profileDivision(get(currentUserPath()).data);
      return isSuperAdmin() || (isChiefCertificateAdmin()
        && (data.get("unit", "") == office
          || data.get("unit", "") == assignment
          || (division == "Field Operations Division"
            && data.get("unit", "") in ["AMIA", "AGRISTAT", "DRRM"])));
    }
    function appearanceDivisionForOffice(office) {
      return office in ["AMIA", "FOD-AMIA"] ? "Agribusiness and Marketing Assistance Division"
        : office in ["AGRISTAT", "FOD-AGRISTAT"] ? "Planning, Monitoring and Evaluation Division"
        : office in ["DRRM", "FOD-DRRM"] ? "Disaster Risk Reduction and Management Division"
        : office;
    }
    function appearanceDivisionForProfile(profile) {
      let version = profile.get("profileFieldsVersion", 0);
      let office = profileOffice(profile);
      let assignment = profileAssignment(profile);
      return version >= 4 ? profileDivision(profile)
        : office == "Regional Field Office"
        ? assignment
        : office == "Field Operations Division" && assignment in ["AGRISTAT", "AMIA", "DRRM"]
          ? appearanceDivisionForOffice(assignment)
          : appearanceDivisionForOffice(office);
    }
    function isAppearanceChiefAdminRecipient(userId, division) {
      let profilePath = /databases/$(database)/documents/users/$(userId);
      return exists(profilePath)
        && get(profilePath).data.get("accountRole", "") == "admin"
        && get(profilePath).data.get("accountStatus", "Approved") == "Approved"
        && hasChiefDesignation(get(profilePath).data)
        && appearanceDivisionForProfile(get(profilePath).data) == division;
    }
    function isFodAppearanceApproverProfile(profile, designation) {
      return profile.get("accountRole", "") == "admin"
        && profile.get("accountStatus", "Approved") == "Approved"
        && profile.get("profileFieldsVersion", 0) == 4
        && profile.get("office", "") == "Division"
        && profile.get("division", "") == "Field Operations Division"
        && profile.get("unit", "") == "Field Operations Division"
        && profile.get("designation", "") == designation;
    }
    function isCurrentFodAppearanceApprover(designation) {
      let userPath = currentUserPath();
      return isVerifiedUser() && exists(userPath)
        && isFodAppearanceApproverProfile(get(userPath).data, designation);
    }
    function certificateScopeOffice(data) {
      return data.get("certificateOffice", data.get("ownerOffice", ""));
    }
    function certificateScopeDivision(data) {
      return data.get("certificateDivision", data.get("ownerDivision", ""));
    }
    function certificateScopeUnit(data) {
      return data.get("certificateUnit", data.get("ownerUnit", ""));
    }
    function isFodAppearanceOwnerRecord(data) {
      return data.get("ownerRole", "") in ["regular", "user"]
        && certificateScopeOffice(data) == "Division"
        && certificateScopeDivision(data) == "Field Operations Division"
        && certificateScopeUnit(data) is string;
    }
    function isFodAppearanceCertificateRecipient(userId, data) {
      let profilePath = /databases/$(database)/documents/users/$(userId);
      let hasProfile = exists(profilePath);
      let profile = hasProfile ? get(profilePath).data : {};
      return hasProfile && isFodAppearanceOwnerRecord(data)
        && ((certificateScopeUnit(data) in ["4K", "APCO - ADN", "APCO - ADS", "APCO - SDN", "APCO - SDS", "APCO - PDI", "CFIDP", "Corn Program", "ELCAC", "Extension and Partnership", "F2C2", "Field Operations Division", "Gender and Development", "Halal Projects", "HVCD Program", "IPM", "Livestock Program", "NUPA Program", "Organic Agriculture Program", "Rice Program", "RSBSA", "SAAD", "Soybean Program"]
            && isFodAppearanceApproverProfile(profile, "Chief"))
          || (certificateScopeUnit(data) in ["AGRISTAT", "AMIA", "DRRM"]
            && isFodAppearanceApproverProfile(profile, "AGRISTAT/DRRM/AMIA Project Leader")));
    }
    function isAppearanceCertificateRecipient(userId, data) {
      return isFodAppearanceCertificateRecipient(userId, data)
        || (!(certificateScopeOffice(data) == "Division" && certificateScopeDivision(data) == "Field Operations Division")
          && isAppearanceChiefAdminRecipient(userId, data.get("division", "")));
    }
    function canReviewAppearanceCertificate(data) {
      let isFodChief = isCurrentFodAppearanceApprover("Chief");
      return isSuperAdmin()
        || (isChiefCertificateAdmin() && !isFodChief
          && data.get("division", "") == appearanceDivisionForProfile(get(currentUserPath()).data))
        || (isFodChief && isFodAppearanceOwnerRecord(data)
          && certificateScopeUnit(data) in ["4K", "APCO - ADN", "APCO - ADS", "APCO - SDN", "APCO - SDS", "APCO - PDI", "CFIDP", "Corn Program", "ELCAC", "Extension and Partnership", "F2C2", "Field Operations Division", "Gender and Development", "Halal Projects", "HVCD Program", "IPM", "Livestock Program", "NUPA Program", "Organic Agriculture Program", "Rice Program", "RSBSA", "SAAD", "Soybean Program"])
        || (isCurrentFodAppearanceApprover("AGRISTAT/DRRM/AMIA Project Leader")
          && isFodAppearanceOwnerRecord(data)
          && certificateScopeUnit(data) in ["AGRISTAT", "AMIA", "DRRM"]);
    }
    function hasValidAppearanceProjectLeaderSignatory(data) {
      let hasRoutedSignatory = data.keys().hasAny(["signatoryAdminId", "signatoryPosition"]);
      let signatoryId = data.get("signatoryAdminId", "missing-signatory");
      let profilePath = /databases/$(database)/documents/users/$(signatoryId);
      let isBlankProjectLeaderRoute = data.get("recordType", "") == "blank"
        && data.keys().hasAll(["signatoryAdminId", "signatoryPosition"])
        && data.signatoryAdminId is string && data.signatoryAdminId.size() > 0 && data.signatoryAdminId.size() <= 128
        && data.signatoryPosition is string && data.signatoryPosition.size() > 0 && data.signatoryPosition.size() <= 120
        && data.signatoryName is string && data.signatoryName.size() > 0 && data.signatoryName.size() <= 120
        && data.designation == "AGRISTAT/DRRM/AMIA Project Leader"
        && data.get("certificateOffice", "") == "Division"
        && data.get("certificateDivision", "") == "Field Operations Division"
        && data.get("certificateUnit", "") in ["AGRISTAT", "AMIA", "DRRM"];
      return isBlankProjectLeaderRoute
        || !hasRoutedSignatory
        || (data.keys().hasAll(["signatoryAdminId", "signatoryPosition"])
          && data.signatoryAdminId is string
          && data.signatoryPosition is string
          && data.signatoryName is string
          && data.designation == "AGRISTAT/DRRM/AMIA Project Leader"
          && data.get("certificateOffice", "") == "Division"
          && data.get("certificateDivision", "") == "Field Operations Division"
          && data.get("certificateUnit", "") in ["AGRISTAT", "AMIA", "DRRM"]
          && exists(profilePath)
          && isFodAppearanceApproverProfile(get(profilePath).data, "AGRISTAT/DRRM/AMIA Project Leader"));
    }
    function canReadAppearanceCertificate(data) {
      return canReviewAppearanceCertificate(data);
    }
    function isValidFodProjectLeaderBlankAppearanceCreate(data) {
      return request.auth != null
        && isVerifiedUser()
        && data.ownerId == request.auth.uid
        && data.ownerRole == "regular"
        && get(currentUserPath()).data.get("accountRole", "") == "regular"
        && signedInOffice() == "Division"
        && signedInDivision() == "Field Operations Division"
        && signedInUnit() in ["AGRISTAT", "AMIA", "DRRM"]
        && data.certificateOffice == "Division"
        && data.certificateDivision == "Field Operations Division"
        && data.certificateUnit == signedInUnit()
        && data.keys().hasOnly(["recordType", "eventTitle", "destination", "ownerRole", "ownerOffice", "ownerDivision", "ownerUnit", "certificateOffice", "certificateDivision", "certificateUnit", "eventDateFrom", "eventDateTo", "people", "signatoryName", "designation", "signatoryPosition", "signatoryAdminId", "division", "ownerId", "createdAt", "status"])
        && data.recordType == "blank"
        && data.eventTitle is string
        && data.eventTitle.size() > 0
        && data.eventTitle.size() <= 240
        && data.destination is string
        && data.destination.size() > 0
        && data.destination.size() <= 180
        && data.eventDateFrom is string
        && data.eventDateFrom.size() == 10
        && data.eventDateTo is string
        && data.eventDateTo.size() == 10
        && data.people is list
        && data.people.size() == 0
        && data.signatoryName is string
        && data.signatoryName.size() > 0
        && data.signatoryName.size() <= 120
        && data.designation is string
        && data.designation.size() > 0
        && data.designation.size() <= 120
        && data.division is string
        && data.division.size() > 0
        && data.division.size() <= 120
        && data.createdAt is timestamp
        && data.status == "Pending"
        && (!data.keys().hasAny(["ownerOffice", "ownerDivision", "ownerUnit"])
          || data.keys().hasAll(["ownerOffice", "ownerDivision", "ownerUnit"]))
        && (!data.keys().hasAny(["signatoryPosition", "signatoryAdminId"])
          || (data.keys().hasAll(["signatoryPosition", "signatoryAdminId"])
            && data.signatoryPosition is string
            && data.signatoryPosition.size() > 0
            && data.signatoryPosition.size() <= 120
            && data.signatoryAdminId is string
            && data.signatoryAdminId.size() > 0
            && data.signatoryAdminId.size() <= 128));
    }
    function isValidFodProjectLeaderAppearanceCreate(data) {
      return request.auth != null
        && isVerifiedUser()
        && data.ownerId == request.auth.uid
        && data.ownerRole == "regular"
        && get(currentUserPath()).data.get("accountRole", "") == "regular"
        && signedInOffice() == "Division"
        && signedInDivision() == "Field Operations Division"
        && signedInUnit() in ["AGRISTAT", "AMIA", "DRRM"]
        && data.certificateOffice == "Division"
        && data.certificateDivision == "Field Operations Division"
        && data.certificateUnit in ["AGRISTAT", "AMIA", "DRRM"]
        && data.keys().hasAll(["eventTitle", "destination", "eventDateFrom", "eventDateTo", "people", "signatoryName", "designation", "division", "ownerRole", "certificateOffice", "certificateDivision", "certificateUnit", "signatoryPosition", "signatoryAdminId", "ownerId", "createdAt"])
        && data.keys().hasOnly(["eventTitle", "destination", "purpose", "ownerRole", "ownerOffice", "ownerDivision", "ownerUnit", "certificateOffice", "certificateDivision", "certificateUnit", "eventDateFrom", "eventDateTo", "people", "signatoryName", "designation", "signatoryPosition", "signatoryAdminId", "division", "ownerId", "createdAt", "recordType", "status"])
        && data.get("recordType", "appearance") == "appearance"
        && data.eventTitle is string
        && data.destination is string
        && data.eventDateFrom is string
        && data.eventDateTo is string
        && data.people is list
        && data.people.size() > 0
        && data.people.size() <= 100
        && data.signatoryName is string
        && data.signatoryName.size() > 0
        && data.signatoryName.size() <= 120
        && data.designation == "AGRISTAT/DRRM/AMIA Project Leader"
        && data.signatoryPosition is string
        && data.signatoryPosition.size() > 0
        && data.signatoryPosition.size() <= 120
        && data.signatoryAdminId is string
        && data.signatoryAdminId.size() > 0
        && data.signatoryAdminId.size() <= 128
        && data.division == "Field Operations Division"
        && data.createdAt is timestamp
        && data.get("status", "") == "Pending"
        && (!data.keys().hasAny(["purpose"]) || (data.purpose is string && data.purpose.size() <= 500))
        && (!data.keys().hasAny(["ownerOffice", "ownerDivision", "ownerUnit"])
          || (data.keys().hasAll(["ownerOffice", "ownerDivision", "ownerUnit"])
            && data.ownerOffice is string && data.ownerOffice.size() > 0
            && data.ownerDivision is string && data.ownerDivision.size() > 0
            && data.ownerUnit is string && data.ownerUnit.size() > 0));
    }
    function validCertificateDecisionUpdate(allowAppearanceSignature) {
      let profile = get(currentUserPath()).data;
      let oldStatus = resource.data.get("status", "Pending");
      let newStatus = request.resource.data.get("status", "");
      let signatureAsset = request.resource.data.get("signatureAsset", "");
      // Every call site first authorizes the reviewer through canReviewAppearanceCertificate or canReviewUnitCertificate.
      return oldStatus != "Approved"
        && newStatus in ["Approved", "Disapproved"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "decidedAt", "decidedBy", "signerName", "signerPosition", "signerDesignation", "signerOffice", "signatureAsset"])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"])
        && request.resource.data.decidedAt is timestamp
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.signerName == profile.get("name", "")
        && request.resource.data.signerPosition == profile.get("position", "")
        && request.resource.data.signerDesignation == profile.get("designation", "")
        && request.resource.data.signerOffice == profileOffice(profile)
        && (signatureAsset == "" || (allowAppearanceSignature
          && resource.data.get("recordType", "appearance") in ["appearance", "blank"]
          && newStatus == "Approved"
          && request.resource.data.signerOffice == "Division"
          && isFodAppearanceOwnerRecord(resource.data)
          && ((signatureAsset == "field_operations_division_chief_signature.png"
              && certificateScopeUnit(resource.data) in ["4K", "APCO - ADN", "APCO - ADS", "APCO - SDN", "APCO - SDS", "APCO - PDI", "CFIDP", "Corn Program", "ELCAC", "Extension and Partnership", "F2C2", "Field Operations Division", "Gender and Development", "Halal Projects", "HVCD Program", "IPM", "Livestock Program", "NUPA Program", "Organic Agriculture Program", "Rice Program", "RSBSA", "SAAD", "Soybean Program"]
              && isFodAppearanceApproverProfile(profile, "Chief")
              && request.resource.data.signerDesignation == "Chief")
            || (signatureAsset == "agristat_and_drrm_focal_persons_amia_project_leader.png"
              && certificateScopeUnit(resource.data) in ["AGRISTAT", "AMIA", "DRRM"]
              && isFodAppearanceApproverProfile(profile, "AGRISTAT/DRRM/AMIA Project Leader")
              && resource.data.get("signatoryAdminId", request.auth.uid) == request.auth.uid
              && request.resource.data.signerDesignation == "AGRISTAT/DRRM/AMIA Project Leader"))));
    }
    function validApprovedProjectLeaderSignatureBackfill() {
      let approverId = resource.data.get("decidedBy", "missing-approver");
      let approverPath = /databases/$(database)/documents/users/$(approverId);
      return request.auth != null
        && isVerifiedUser()
        && approverId is string
        && approverId == request.auth.uid
        && exists(approverPath)
        && isFodAppearanceApproverProfile(get(approverPath).data, "AGRISTAT/DRRM/AMIA Project Leader")
        && resource.data.get("status", "") == "Approved"
        && request.resource.data.get("status", "") == "Approved"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["signatureAsset"])
        && request.resource.data.get("signatureAsset", "") == "agristat_and_drrm_focal_persons_amia_project_leader.png"
        && resource.data.get("signerOffice", "") == "Division"
        && resource.data.get("signerDesignation", "") in ["", "AGRISTAT/DRRM/AMIA Project Leader"]
        && isFodAppearanceOwnerRecord(resource.data)
        && certificateScopeUnit(resource.data) in ["AGRISTAT", "AMIA", "DRRM"];
    }
    function isValidPermitDecisionUpdate() {
      let decisionKey = request.resource.data.get("lastDecisionKey", "");
      let safeDecisionKey = decisionKey is string ? decisionKey : "";
      let oldStatuses = resource.data.get("personStatuses", {});
      let newStatuses = request.resource.data.get("personStatuses", {});
      let oldDecision = oldStatuses is map ? oldStatuses.get(safeDecisionKey, {}) : {};
      let newDecision = newStatuses is map ? newStatuses.get(safeDecisionKey, {}) : {};
      return isPermitAdmin()
        && decisionKey is string
        && decisionKey.size() > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["personStatuses", "lastDecisionKey"])
        && oldStatuses is map
        && newStatuses is map
        && oldDecision is map
        && newDecision is map
        && newStatuses.diff(oldStatuses).affectedKeys().hasOnly([decisionKey])
        && newStatuses.diff(oldStatuses).affectedKeys().hasAny([decisionKey])
        && oldDecision.get("status", "Pending") == "Pending"
        && newDecision.get("status", "") in ["Approved", "Disapproved"]
        && newDecision.get("signerName", "") == get(currentUserPath()).data.get("name", "")
        && newDecision.diff(oldDecision).affectedKeys().hasOnly(["status", "decidedAt", "decidedBy", "signerName", "approvedPermitNo"]);
    }
    function validProfileOfficeDivisionUnit(office, division, unit) {
      return (office == "Division" && division == "Administrative Division"
          && unit in ["Administrative Division", "General Services Section", "Human Resource Section"])
        || (office == "Division" && division == "Agribusiness and Marketing Assistance Division"
          && unit == "Agribusiness and Marketing Assistance Division")
        || (office == "Division" && division == "Field Operations Division"
          && unit in ["4K", "AGRISTAT", "AMIA", "DRRM", "APCO - ADN", "APCO - ADS", "APCO - SDN", "APCO - SDS", "APCO - PDI", "CFIDP", "Corn Program", "ELCAC", "Extension and Partnership", "F2C2", "Field Operations Division", "Gender and Development", "Halal Projects", "HVCD Program", "IPM", "Livestock Program", "NUPA Program", "Organic Agriculture Program", "Rice Program", "RSBSA", "SAAD", "Soybean Program"])
        || (office == "Division" && division == "Finance Division"
          && unit in ["Budget Section", "Accounting Section", "Finance Division"])
        || (office == "Division" && division == "Integrated Laboratories Division"
          && unit in ["Integrated Laboratories Division", "NHSP"])
        || (office == "Division" && division == "Planning, Monitoring and Evaluation Division"
          && unit in ["Information and Communications Technology Unit", "Planning, Monitoring and Evaluation Division"])
        || (office == "Division" && division == "Regional Agricultural Engineering Division"
          && unit == "Regional Agricultural Engineering Division")
        || (office == "Division" && division == "Regulatory Division"
          && unit == "Regional Agricultural Engineering Division")
        || (office == "Division" && division == "Research Division"
          && unit in ["Del Monte RES", "Modernization and ORDA", "Research Division", "Tagbina RES", "Trento RES"])
        || (office == "Office of the Regional Executive Director"
          && division in ["Office of the Regional Executive Director", "RTD for Operations", "RTD for Research and Regulations"]
          && unit == division);
    }
    function validUserProfile(data) {
      return data.keys().hasAll(["name", "position", "office", "division", "unit", "profileFieldsVersion", "emailVerified", "accountRole", "accountStatus", "isRootSuperAdmin"])
        && data.keys().hasOnly(["name", "position", "office", "division", "unit", "profileFieldsVersion", "designation", "firstName", "middleName", "lastName", "gender", "photoURL", "address", "taxIdentificationNo", "accountRole", "accountStatus", "isRootSuperAdmin", "emailVerified", "registrationStage", "welcomeNotificationSeenAt", "createdAt"])
        && data.emailVerified is bool
        && data.isRootSuperAdmin is bool
        && data.accountRole in ["superadmin", "admin", "regular"]
        && data.accountStatus in ["Pending", "Approved", "Disapproved"]
        && (!data.keys().hasAny(["gender"]) || data.gender in ["Male", "Female"])
        && (!data.keys().hasAny(["firstName"]) || (data.firstName is string && data.firstName.size() <= 60))
        && (!data.keys().hasAny(["middleName"]) || (data.middleName is string && data.middleName.size() <= 60))
        && (!data.keys().hasAny(["lastName"]) || (data.lastName is string && data.lastName.size() <= 60))
        && (!data.keys().hasAny(["photoURL"]) || (data.photoURL is string && data.photoURL.size() <= 2048))
        && (!data.keys().hasAny(["address"]) || (data.address is string && data.address.size() > 0 && data.address.size() <= 200))
        && (!data.keys().hasAny(["taxIdentificationNo"]) || (data.taxIdentificationNo is string && data.taxIdentificationNo.size() > 0 && data.taxIdentificationNo.size() <= 30))
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.position is string
        && data.position.size() <= 120
        && (!data.keys().hasAny(["designation"]) || (data.designation is string && data.designation.size() <= 2000))
        && (!data.keys().hasAny(["welcomeNotificationSeenAt"]) || data.welcomeNotificationSeenAt is timestamp)
        && (!data.keys().hasAny(["createdAt"]) || data.createdAt is timestamp)
        && data.office is string
        && data.office.size() > 0
        && data.office.size() <= 120
        && data.division is string
        && data.division.size() > 0
        && data.division.size() <= 120
        && data.unit is string
        && data.unit.size() > 0
        && data.unit.size() <= 120
        && validProfileOfficeDivisionUnit(data.office, data.division, data.unit)
        && data.profileFieldsVersion == 4
        && (!data.keys().hasAny(["registrationStage"]) || data.registrationStage == "complete");
    }
    function validRegistrationMarker(data) {
      let isRoot = request.auth.token.email == "rjamescute2@gmail.com";
      let isAdmin = request.auth.token.email == "gerlieantipaso27@gmail.com";
      return data.keys().hasOnly(["registrationStage", "emailVerified", "accountRole", "accountStatus", "isRootSuperAdmin"])
        && data.registrationStage == "detailsRequired"
        && data.emailVerified == false
        && data.accountRole == (isRoot ? "superadmin" : isAdmin ? "admin" : "regular")
        && data.accountStatus == "Pending"
        && data.isRootSuperAdmin == isRoot;
    }
    function isAccomplishmentReportEditable(report) {
      let manilaNow = request.time + duration.value(8, "h");
      let currentMonth = string(manilaNow.year()) + "-" + (manilaNow.month() < 10 ? "0" + string(manilaNow.month()) : string(manilaNow.month()));
      let previousMonth = manilaNow.month() == 1
        ? string(manilaNow.year() - 1) + "-12"
        : string(manilaNow.year()) + "-" + (manilaNow.month() - 1 < 10 ? "0" + string(manilaNow.month() - 1) : string(manilaNow.month() - 1));
      return report.month is string
        && report.month.matches("[0-9]{4}-(0[1-9]|1[0-2])")
        && ((report.cycle == 1
            && (currentMonth < report.month
              || (currentMonth == report.month && manilaNow.day() < 21)))
          || (report.cycle == 2
            && (currentMonth <= report.month
              || (previousMonth == report.month && manilaNow.day() < 6))));
    }
