          && (!request.resource.data.keys().hasAny(["photoURL"]) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048))
          && (!request.resource.data.keys().hasAny(["fullSignatureURL"]) || (request.resource.data.fullSignatureURL is string && request.resource.data.fullSignatureURL.size() <= 2048))
          && (!request.resource.data.keys().hasAny(["initialSignatureURL"]) || (request.resource.data.initialSignatureURL is string && request.resource.data.initialSignatureURL.size() <= 2048))
